// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "mysql"
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum BudgetPeriod {
  DALIY
  WEEKLY
  MONTHLY
  YEARLY
}

enum BudgetCycleStatus {
  ACTIVE
  CLOSED
}

enum BillingCycle {
  DALIY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

enum GoalTransferType {
  IN
  OUT
}

model User {
  id            Int            @id @default(autoincrement())
  name          String
  email         String         @unique
  password      String
  accounts      Account[]
  categories    Category[]
  budgets       Budget[]
  goals         Goal[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id            Int            @id @default(autoincrement())
  userId        Int
  name          String
  balance       Decimal        @db.Decimal(12, 2)
  openingBalance Decimal       @default(0) @db.Decimal(12, 2)
  user          User           @relation(fields: [userId], references: [id])
  deletedAt     DateTime?
  transactions  Transaction[]
  transfersFrom Transfer[]     @relation("TransferFrom")
  transfersTo   Transfer[]     @relation("TransferTo")
  goalTransfers GoalTransfer[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, deletedAt])
}

model Category {
  id            Int            @id @default(autoincrement())
  /// NULL = system default category
  userId        Int?
  name          String
  type          CategoryType
  parentId      Int?
  user          User?          @relation(fields: [userId], references: [id])
  parent        Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  deletedAt     DateTime?
  children      Category[]     @relation("CategoryHierarchy")
  transactions  Transaction[]
  budgets       Budget[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())

  @@index([userId, deletedAt])
}

model Transaction {
  id             Int           @id @default(autoincrement())
  accountId      Int
  categoryId     Int
  subscriptionId Int?
  amount         Decimal       @db.Decimal(12, 2)
  date           DateTime
  note           String?
  deletedAt      DateTime?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  account        Account       @relation(fields: [accountId], references: [id])
  category       Category      @relation(fields: [categoryId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([accountId, date])
  @@index([categoryId, date])
  @@index([accountId, deletedAt])
}

model Transfer {
  id            Int      @id @default(autoincrement())
  fromAccountId Int
  toAccountId   Int
  amount        Decimal  @db.Decimal(12, 2)
  date          DateTime
  note          String?
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id])
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Budget {
  id         Int           @id @default(autoincrement())
  userId     Int
  categoryId Int
  amount     Decimal       @db.Decimal(12, 2)
  period     BudgetPeriod
  startDate  DateTime
  autoReset  Boolean       @default(false)
  deletedAt  DateTime?
  user       User          @relation(fields: [userId], references: [id])
  category   Category      @relation(fields: [categoryId], references: [id])
  cycles     BudgetCycle[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([userId, deletedAt])
}

model BudgetCycle {
  id          Int               @id @default(autoincrement())
  budgetId    Int
  startDate   DateTime
  endDate     DateTime
  spentAmount Decimal           @default(0) @db.Decimal(12, 2)
  status      BudgetCycleStatus @default(ACTIVE)
  budget      Budget            @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
}

model Goal {
  id           Int            @id @default(autoincrement())
  userId       Int
  name         String
  targetAmount Decimal        @db.Decimal(12, 2)
  deletedAt    DateTime?
  user         User           @relation(fields: [userId], references: [id])
  transfers    GoalTransfer[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model GoalTransfer {
  id        Int              @id @default(autoincrement())
  goalId    Int
  accountId Int
  type      GoalTransferType
  amount    Decimal          @db.Decimal(12, 2)
  date      DateTime
  note      String?
  goal      Goal             @relation(fields: [goalId], references: [id])
  account   Account          @relation(fields: [accountId], references: [id])
  createdAt DateTime         @default(now())
}

model Subscription {
  id              Int                @id @default(autoincrement())
  userId          Int
  categoryId      Int
  name            String
  amount          Decimal            @db.Decimal(12, 2)
  startDate       DateTime
  billingCycle    BillingCycle
  nextBillingDate DateTime
  reminderEnabled Boolean            @default(false)
  reminderDays    Int? // 1 or 2
  status          SubscriptionStatus @default(ACTIVE)
  user            User               @relation(fields: [userId], references: [id])
  category        Category           @relation(fields: [categoryId], references: [id])
  transactions    Transaction[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}
